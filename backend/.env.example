# AranduX backend - environment example
DATABASE_URL=your-turso-url
DATABASE_TOKEN=your-turso-token
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ADMIN_BOOTSTRAP_EMAIL=contato@agroisync.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-bootstrap-admin
ADMIN_BOOTSTRAP_TOKEN=change-me-bootstrap-token
CERTIFICATE_DEFAULT_PASSWORD=
FRONTEND_URL=https://arandux.com
ARANDUX_DEPLOY_REGION=sa-east-1
ARANDUX_SUPPORTED_REGIONS=sa-east-1,us-east-1
ARANDUX_EDGE_WORKER_URL=
ARANDUX_READ_POOL_HINT=primary
ARANDUX_API_GATEWAY_URL=
ARANDUX_REGION_ENFORCE=false
ARANDUX_REGION_ALLOW_UNSET=true
ARANDUX_REGION_BLOCK_UNSET=false
# URL pública do backend (webhooks Pagar.me / Asaas devem apontar para cá)
API_PUBLIC_URL=https://api.arandux.com
# Fiscal / pagamentos em produção: use provider real ou ALLOW_MOCK_* só em homologação
NFE_PROVIDER=mock
MDFE_PROVIDER=
ALLOW_MOCK_FISCAL=
PIX_PROVIDER=mock
BOLETO_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=
PAGARME_API_KEY=sk_xxx
# Pode ser usado como token direto ou chave HMAC SHA256 para assinatura
PAGARME_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=
## Preco de excedente por unidade (SaaS usage billing)
BILLING_OVERAGE_API_REQUEST_PRICE=0.002
BILLING_OVERAGE_FISCAL_DOC_PRICE=0.6
BILLING_OVERAGE_SALE_PRICE=0.15
SUBSCRIPTION_GRACE_DAYS=7
BILLING_DUNNING_AUTOMATION_ENABLED=true
BILLING_DUNNING_INTERVAL_MINUTES=60
BILLING_DUNNING_WEBHOOK_URL=
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120
PUBLIC_API_OUTBOUND_WEBHOOK_URL=
PUBLIC_API_OUTBOUND_WEBHOOK_SECRET=
BILLING_WEBHOOK_AUTOREPLAY_ENABLED=true
BILLING_WEBHOOK_AUTOREPLAY_INTERVAL_MINUTES=10
BILLING_WEBHOOK_AUTOREPLAY_MAX_ITEMS=5
BILLING_WEBHOOK_IDEMPOTENCY_MINUTES=60
BILLING_WEBHOOK_CIRCUIT_BREAKER_THRESHOLD=5
BILLING_WEBHOOK_CIRCUIT_BREAKER_WINDOW_MINUTES=10
BILLING_WEBHOOK_CIRCUIT_BREAKER_COOLDOWN_MINUTES=15
BILLING_WEBHOOK_RETRIES_NORMAL=3
BILLING_WEBHOOK_RETRIES_HIGH=4
BILLING_WEBHOOK_RETRIES_CRITICAL=5
BILLING_WEBHOOK_BACKOFF_JITTER_PCT=25
BILLING_WEBHOOK_DESTINATION_RATE_LIMIT_PER_MINUTE=60
BILLING_WEBHOOK_AUTO_QUARANTINE_FAILURES=6
BILLING_WEBHOOK_AUTO_QUARANTINE_MINUTES=15
BILLING_WEBHOOK_SLO_TARGET_SUCCESS_RATE=99.5
BILLING_WEBHOOK_FAILOVER_SWITCH_COOLDOWN_MINUTES=30
BILLING_WEBHOOK_HEALTHCHECK_ENABLED=true
BILLING_WEBHOOK_HEALTHCHECK_INTERVAL_MINUTES=5
BILLING_WEBHOOK_RESTORE_MIN_HEALTH_SCORE=80
BILLING_WEBHOOK_CANARY_STEPS=10,25,50,100
BILLING_WEBHOOK_CANARY_STEP_STABILITY_MINUTES=15
ASAAS_API_TOKEN=
# Igual ao token já configurado no painel Asaas (Integrações > Webhook) — não é chave nova; só precisa bater com o header asaas-access-token
ASAAS_WEBHOOK_SECRET=
ASAAS_SANDBOX=true
