{
  "name": "backend",
  "version": "1.0.0",
  "description": "AranduX backend (NestJS + Prisma)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:worker": "node scripts/copy-worker.mjs cloudflare-worker",
    "build:worker:ai": "node scripts/copy-worker.mjs cloudflare-worker-ai",
    "start": "node dist/main.js",
    "start:dev": "node scripts/dev-watch.mjs",
    "start:prod": "node dist/main.js",
    "deploy": "npm run build:worker && wrangler deploy",
    "deploy:preview": "npm run build:worker && wrangler deploy",
    "deploy:production": "npm run build:worker && wrangler deploy -e production",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "setup:db": "node setup-database.js",
    "setup:planetscale": "node scripts/setup-planetscale.js",
    "setup:turso": "node scripts/setup-turso.js",
    "migrate:turso": "node scripts/apply-migrations.js",
    "init:plans": "node scripts/init-plans.js",
    "test:db": "node test/db-connection.js",
    "create-admin": "node scripts/create-admin-simple.js",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/client": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "^4.18.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.8.2",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.15.0",
    "prisma": "^7.0.1",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@swc/core": "^1.15.32",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.53.0"
  }
}
